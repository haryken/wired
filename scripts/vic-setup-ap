#!/bin/sh
# Open setup AP (no password) — ConnMan tethering cannot do open WiFi.
# ConnMan/wpa_supplicant must be stopped first or AP never broadcasts.
# Usage: vic-setup-ap on [ssid] | off | status
set -eu
IFACE="${WIREOS_WLAN:-wlan0}"
AP_IP="192.168.4.1"
AP_NET="192.168.4"
CONF="/run/wireos-ap.conf"
PID="/run/wireos-ap-wpa.pid"
DHCP_PID="/run/wireos-ap-dhcp.pid"
DHCP_CONF="/run/wireos-ap-dhcp.conf"
DHCP_LEASES="/run/wireos-ap-dhcp.leases"
FLAG="/run/wireos-setup-ap"
LOG="/run/vic-setup-ap.log"

log() {
  echo "vic-setup-ap: $*" | tee -a "$LOG" > /dev/kmsg 2>/dev/null || echo "vic-setup-ap: $*"
}

ssid_default() {
  n="$(getprop anki.robot.name 2>/dev/null || true)"
  [ -n "$n" ] || n="Vector"
  echo "$n"
}

connman_wifi_powered() {
  busctl --system call net.connman /net/connman/technology/wifi \
    net.connman.Technology SetProperty sv Powered b "$1" >/dev/null 2>&1 || true
}

connman_tether_off() {
  busctl --system call net.connman /net/connman/technology/wifi \
    net.connman.Technology SetProperty sv Tethering b false >/dev/null 2>&1 || true
}

ipt_allow() {
  # Never abort the script if iptables is missing/busy.
  iptables -C "$@" 2>/dev/null || iptables -I "$@" 2>/dev/null || true
}

# Stock Vector firewall: INPUT DROP, DHCP only on "tether", web only :8080.
# WireOS open AP is on wlan0 + captive on :80 — must open before DHCP starts.
open_ap_firewall() {
  ipt_allow INPUT -p udp --dport 67 -i "$IFACE" -j ACCEPT
  ipt_allow INPUT -p udp --dport 68 -i "$IFACE" -j ACCEPT
  # Also allow without iface match (some kernels rename / bridge briefly).
  ipt_allow INPUT -p udp --dport 67 -j ACCEPT
  ipt_allow INPUT -p udp --dport 68 -j ACCEPT
  ipt_allow INPUT -p udp --dport 53 -i "$IFACE" -j ACCEPT
  ipt_allow INPUT -p tcp --dport 53 -i "$IFACE" -j ACCEPT
  ipt_allow INPUT -p tcp --dport 80 -j ACCEPT
  ipt_allow INPUT -p tcp --dport 8080 -j ACCEPT
  ipt_allow INPUT -p tcp --dport 8081 -j ACCEPT
  # Keep stock wired untouched on :80. Only AP clients are redirected to the
  # independent hotspot portal; normal home-LAN traffic still reaches wired.
  iptables -t nat -C PREROUTING -i "$IFACE" -p tcp --dport 80 \
    -j REDIRECT --to-ports 8081 2>/dev/null ||
    iptables -t nat -I PREROUTING -i "$IFACE" -p tcp --dport 80 \
      -j REDIRECT --to-ports 8081 2>/dev/null || true
  log "firewall opened for AP (dhcp/dns/80/8080)"
}

ensure_ap_ip() {
  ip link set "$IFACE" up 2>/dev/null || true
  if ! ip -4 addr show dev "$IFACE" 2>/dev/null | grep -q "inet $AP_IP/"; then
    ip addr add "$AP_IP/24" broadcast "${AP_NET}.255" dev "$IFACE" 2>/dev/null || true
  fi
}

stop_ap() {
  while iptables -t nat -D PREROUTING -i "$IFACE" -p tcp --dport 80 \
    -j REDIRECT --to-ports 8081 2>/dev/null; do :; done
  if [ -f "$PID" ]; then
    kill "$(cat "$PID")" 2>/dev/null || true
    rm -f "$PID"
  fi
  if [ -f "$DHCP_PID" ]; then
    kill "$(cat "$DHCP_PID")" 2>/dev/null || true
    rm -f "$DHCP_PID"
  fi
  if [ -f /run/wireos-ap-dns.pid ]; then
    kill "$(cat /run/wireos-ap-dns.pid)" 2>/dev/null || true
    rm -f /run/wireos-ap-dns.pid
  fi
  # Best-effort: stop leftover DHCP/DNS helpers we may have started.
  killall udhcpd 2>/dev/null || true
  # Only our AP dnsmasq (pid file); also clear stragglers on this robot.
  killall dnsmasq 2>/dev/null || true
  killall wpa_supplicant 2>/dev/null || true
  ip addr del "$AP_IP/24" dev "$IFACE" 2>/dev/null || true
  rm -f "$FLAG" "$CONF" "$DHCP_CONF" "$DHCP_LEASES"
}

start_dhcp() {
  : >"$DHCP_LEASES"
  mkdir -p /run

  # Prefer dnsmasq when present (DHCP + captive DNS * → AP IP).
  # If dnsmasq is missing, udhcpd handles DHCP and wired's captive-dns.go
  # answers UDP :53 so phones still auto-open the portal.
  if command -v dnsmasq >/dev/null 2>&1; then
    dnsmasq --interface="$IFACE" --bind-interfaces --except-interface=lo \
      --dhcp-range="${AP_NET}.2,${AP_NET}.100,12h" \
      --dhcp-option=3,"$AP_IP" --dhcp-option=6,"$AP_IP" \
      --dhcp-option=114,"http://${AP_IP}/wifi" \
      --address=/#/"$AP_IP" --no-resolv --port=53 \
      --pid-file=/run/wireos-ap-dns.pid \
      --log-facility="$LOG" >/dev/null 2>&1 || true
    sleep 0.3
    if [ -f /run/wireos-ap-dns.pid ] && kill -0 "$(cat /run/wireos-ap-dns.pid)" 2>/dev/null; then
      cp -f /run/wireos-ap-dns.pid "$DHCP_PID" 2>/dev/null || true
      log "dnsmasq DHCP+DNS running pid=$(cat /run/wireos-ap-dns.pid)"
      return 0
    fi
    log "dnsmasq failed to stay up — falling back to udhcpd (+ wired captive DNS)"
  else
    log "dnsmasq not installed — udhcpd + wired captive DNS on :53"
  fi

  # busybox udhcpd requires a writable lease_file or it exits immediately.
  cat >"$DHCP_CONF" <<EOF
start		${AP_NET}.2
end		${AP_NET}.100
interface	$IFACE
lease_file	$DHCP_LEASES
pidfile		$DHCP_PID
option	subnet	255.255.255.0
option	router	$AP_IP
option	dns	$AP_IP
# DHCP option 114 (RFC 8910): http://192.168.4.1/wifi
option	0x72	687474703a2f2f3139322e3136382e342e312f77696669
option	lease	43200
EOF

  if command -v udhcpd >/dev/null 2>&1; then
    udhcpd -f "$DHCP_CONF" >>"$LOG" 2>&1 &
    echo $! >"$DHCP_PID"
  elif command -v busybox >/dev/null 2>&1 && busybox --list 2>/dev/null | grep -q udhcpd; then
    busybox udhcpd -f "$DHCP_CONF" >>"$LOG" 2>&1 &
    echo $! >"$DHCP_PID"
  else
    log "ERROR: no udhcpd/dnsmasq — phone will not get an IP"
    return 1
  fi

  sleep 0.4
  if [ -f "$DHCP_PID" ] && kill -0 "$(cat "$DHCP_PID")" 2>/dev/null; then
    log "udhcpd running pid=$(cat "$DHCP_PID") iface=$IFACE range=${AP_NET}.2-${AP_NET}.100"
    return 0
  fi
  log "ERROR: udhcpd exited — check $LOG / $DHCP_CONF"
  return 1
}

cmd="${1:-status}"
case "$cmd" in
  status)
    if [ -f "$FLAG" ]; then
      echo "on $(tr '\n' ' ' <"$FLAG")"
      exit 0
    fi
    echo off
    exit 1
    ;;
  off)
    # stop_ap killall's the open-AP wpa. systemctl start is often a no-op if
    # systemd still thinks the unit is up → ConnMan stays Powered=false / empty
    # services for 20s+ (hotspot join felt much slower than BLE). Always restart.
    stop_ap
    systemctl restart wpa_supplicant >/dev/null 2>&1 || systemctl start wpa_supplicant >/dev/null 2>&1 || true
    systemctl restart connman >/dev/null 2>&1 || systemctl start connman >/dev/null 2>&1 || true
    sleep 1
    connman_wifi_powered true
    echo "vic-setup-ap off"
    ;;
  on)
    SSID="${2:-$(ssid_default)}"
    SSID="$(printf '%s' "$SSID" | tr -d '\n\r\"')"
    [ -n "$SSID" ] || SSID="Vector"
    : >"$LOG"
    log "starting open AP ssid=$SSID"

    # Scan + cache BEFORE killing client radio.
    CACHE_DATA="/data/lib/connman/wireos-wifi-scan.json"
    CACHE_RUN="/run/wireos-wifi-scan.json"
    mkdir -p /data/lib/connman /run
    connman_wifi_powered true
    connmanctl scan wifi >/dev/null 2>&1 || \
      busctl --system call net.connman /net/connman/technology/wifi \
        net.connman.Technology Scan >/dev/null 2>&1 || true
    sleep 2
    TMP_JSON="$(mktemp /run/wireos-scan.XXXXXX 2>/dev/null || echo /run/wireos-scan.tmp)"
    connmanctl services 2>/dev/null | awk '
      BEGIN { print "["; n=0 }
      {
        svc=$NF
        if (svc !~ /^wifi_/) next
        line=$0
        sub(/^[\* ]+[A-Za-z]*[ ]*/, "", line)
        sub(/[ \t]+wifi_[^ \t]+$/, "", line)
        gsub(/^[ \t]+|[ \t]+$/, "", line)
        if (line == "" || line ~ /^wifi_/) next
        gsub(/\\/, "\\\\", line); gsub(/"/, "\\\"", line)
        secure = (svc ~ /_none$/) ? "false" : "true"
        if (n++) printf ","
        printf "{\"ssid\":\"%s\",\"signal\":60,\"secure\":%s}", line, secure
      }
      END { print "]" }
    ' >"$TMP_JSON" 2>/dev/null || echo '[]' >"$TMP_JSON"
    cp -f "$TMP_JSON" "$CACHE_DATA" 2>/dev/null || true
    cp -f "$TMP_JSON" "$CACHE_RUN" 2>/dev/null || true
    rm -f "$TMP_JSON"
    log "prescan cached $(wc -c <"$CACHE_DATA" 2>/dev/null || echo 0) bytes"

    stop_ap
    connman_tether_off
    connman_wifi_powered false
    # ConnMan owns wlan0; a second wpa_supplicant never broadcasts.
    systemctl stop connman >/dev/null 2>&1 || true
    systemctl stop wpa_supplicant >/dev/null 2>&1 || true
    sleep 1
    killall wpa_supplicant 2>/dev/null || true
    sleep 1
    ip link set "$IFACE" down 2>/dev/null || true
    ip addr flush dev "$IFACE" 2>/dev/null || true
    ip link set "$IFACE" up
    ensure_ap_ip

    # Open firewall BEFORE DHCP so Discover packets are not DROPped.
    open_ap_firewall

    cat >"$CONF" <<EOF
ctrl_interface=/var/run/wpa_supplicant
update_config=0
ap_scan=2
network={
	ssid="$SSID"
	mode=2
	frequency=2437
	key_mgmt=NONE
}
EOF
    rm -rf /var/run/wpa_supplicant 2>/dev/null || true
    mkdir -p /var/run/wpa_supplicant
    ok=0
    if wpa_supplicant -B -D nl80211 -i "$IFACE" -c "$CONF" -P "$PID" >>"$LOG" 2>&1; then
      ok=1
    elif wpa_supplicant -B -i "$IFACE" -c "$CONF" -P "$PID" >>"$LOG" 2>&1; then
      ok=1
    fi
    if [ "$ok" -ne 1 ]; then
      log "wpa_supplicant AP failed"
      systemctl start wpa_supplicant >/dev/null 2>&1 || true
      systemctl start connman >/dev/null 2>&1 || true
      sleep 1
      connman_wifi_powered true
      exit 1
    fi

    # wpa may briefly flap the iface — re-apply IP and firewall, then DHCP.
    sleep 0.5
    ensure_ap_ip
    open_ap_firewall
    if ! start_dhcp; then
      log "DHCP failed — retry once"
      sleep 1
      ensure_ap_ip
      open_ap_firewall
      start_dhcp || log "DHCP still failed"
    fi

    printf '%s\nopen\n' "$SSID" >"$FLAG"
    log "on ssid=$SSID ip=$AP_IP (open, no password) iface=$(ip -4 -o addr show dev "$IFACE" 2>/dev/null | awk '{print $4}')"
    echo "vic-setup-ap on ssid=$SSID ip=$AP_IP (open)"
    ;;
  *)
    echo "usage: vic-setup-ap on [ssid] | off | status" >&2
    exit 2
    ;;
esac
